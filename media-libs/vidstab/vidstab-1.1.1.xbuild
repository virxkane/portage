DESCRIPTION="Video stabilization library"

HOMEPAGE="https://github.com/georgmartius/vid.stab"

SRC_URI="https://github.com/georgmartius/vid.stab/archive/v${PV}.tar.gz -> ${P}.tar.gz"

LICENSE="GPL-2+"

USE_CMAKE=yes

SOURCES_DIR="vid.stab-${PV}"

src_configure()
{
	econf -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DUSE_OMP=ON \
		-DBUILD_SHARED_LIBS=OFF
}
